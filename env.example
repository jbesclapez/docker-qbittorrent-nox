# =============================================================================
# qBittorrent-nox GhostTrackers Configuration
# =============================================================================

# Legal Notice (required)
# Set to "confirm" to accept qBittorrent's legal notice
QBT_LEGAL_NOTICE=confirm

# qBittorrent Version
# Specify the qBittorrent version tag (e.g., "5.1.2" for release-5.1.2)
# Available versions: https://github.com/qbittorrent/qBittorrent/tags
QBT_VERSION=5.1.2

# Web UI Configuration
# Port for accessing the qBittorrent web interface
QBT_WEBUI_PORT=8085

# Storage Paths
# Full path where qBittorrent will store its configuration files
# Make sure this directory exists and has appropriate permissions
QBT_CONFIG_PATH=/volume1/docker/qbittorrent-ghostrackers/config

# Full path where torrents will be downloaded
# Make sure this directory exists and has appropriate permissions  
QBT_DOWNLOADS_PATH=/volume1/downloads

# User and Group IDs
# Use 'id <username>' command to find your user and group IDs
# Example: id jbesclapez → uid=1029(jbesclapez) gid=100(users)
PUID=1029
PGID=100

# Additional Group IDs (optional)
# Comma-separated list of additional group IDs if needed
# PAGID=1000,1001

# Time Zone
# Set your local timezone (e.g., Europe/Paris, America/New_York, Asia/Tokyo)
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

# File Creation Mask (optional)
# Controls default permissions for created files/folders
# Common values: 022 (755/644), 002 (775/664), 000 (777/666)
UMASK=022

# =============================================================================
# Docker Image Configuration (for manual builds)
# =============================================================================

# Docker image to use
# For GitHub Container Registry: ghcr.io/yourusername/yourrepo:tag
# For local builds: qbittorrent-nox-ghostrackers:latest
DOCKER_IMAGE=qbittorrent-nox-ghostrackers:latest

# Build Arguments (for local builds)
# Pre-built libtorrent artifact URL (GitHub Actions)
LIBTORRENT_ARTIFACT_URL=https://github.com/jbesclapez/libtorrent/actions/runs/16276276484/artifacts/3529935533

# =============================================================================
# Network Configuration (optional)
# =============================================================================

# Custom Docker network (optional)
# Leave empty to use default bridge network
# DOCKER_NETWORK=qbittorrent-network

# Port Configuration
# BitTorrent protocol ports (TCP and UDP)
# These should match the port configured in qBittorrent settings
QBT_BT_PORT=6881

# =============================================================================
# Advanced Options (optional)
# =============================================================================

# Container name
CONTAINER_NAME=qbittorrent-nox-ghostrackers

# Restart policy
RESTART_POLICY=unless-stopped

# Memory limit (optional)
# Example: 2g, 1024m, 512m
# MEMORY_LIMIT=2g

# CPU limit (optional)  
# Example: 1.5, 2.0 (number of CPU cores)
# CPU_LIMIT=2.0 